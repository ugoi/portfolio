---
import "../index.css";
const { title = "Stefan Dukic — In meinem Element", canonical = "https://stefandukic.com/" } = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#061924" />
    <title>{title}</title>
    <meta
      name="description"
      content="Wasser im Blut. Technik im Kopf. Stefan Dukic — Bademeister, Macher und neugieriger Kopf aus Zürich."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://stefandukic.com/" />
    <meta property="og:title" content="Stefan Dukic — In meinem Element" />
    <meta
      property="og:description"
      content="Bademeister von Beruf. Macher aus Überzeugung. Wasser, Handwerk und Technik."
    />
    <meta
      property="og:image"
      content="https://stefandukic.com/images/stefan-greece.jpeg"
    />
    <meta name="htmx-config" content='{"selfRequestsOnly":true,"allowEval":false,"allowScriptTags":false,"includeIndicatorStyles":false}' />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Stefan Dukic",
        "url": "https://stefandukic.com/",
        "jobTitle": "Bademeister",
        "description": "Wasser im Blut. Technik im Kopf."
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
