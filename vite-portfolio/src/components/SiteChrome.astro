---
import { MAX_DIVE_DEPTH } from "../dive";
---
      <div class="site-chrome">
        <header class="site-header">
          <a class="wordmark" href="#top" aria-label="Stefan Dukic – zurück zur Oberfläche">
            <span>Stefan Dukic<small>WASSER. HANDWERK. TECHNIK.</small></span>
          </a>
          <nav aria-label="Hauptnavigation">
            <a href="#about">Der Mensch</a>
            <a href="#elements">Der Antrieb</a>
            <a class="nav-contact" href="/kontakt" data-contact-open>Sag Hallo</a>
          </nav>
        </header>
        <aside aria-label="Tauchgang und Darstellung">
        <div class="depth-instrument">
          <div class="depth-display" role="meter" aria-label="Virtuelle Tauchtiefe in Metern" aria-valuemin={0} aria-valuemax={MAX_DIVE_DEPTH} aria-valuenow="0">
            <span class="micro-label">OBERFLÄCHE</span>
            <span class="depth-reading"><strong>0</strong><span>m</span></span>
          </div>
          <div class="depth-ruler" aria-hidden="true">
            {[0, 10, 20, 30, 40, MAX_DIVE_DEPTH].map(mark => <span>{mark}</span>)}
            <i class="depth-marker" style="top:0%" />
          </div>
          <span class="depth-end" aria-hidden="true">{MAX_DIVE_DEPTH} M</span>
        </div>
        <div class="journey-controls">
          <span class="journey-position" aria-hidden="true"><i /><span data-chapter>01 / OBERFLÄCHE</span></span>
          <div class="scene-controls" hidden role="group" aria-label="Darstellung der Wasserwelt">
            <button class="motion-button" type="button" aria-label="Animation starten" hidden><span data-motion-icon aria-hidden="true">▶</span><span data-motion-label>Animation</span></button>
          </div>
        </div>
        </aside>
      </div>
