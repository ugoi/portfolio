# Server-only, configured in Vercel per environment. Never use PUBLIC_ prefixes.
RESEND_API_KEY=
# A fixed sender on your verified domain, e.g. Stefan <kontakt@mail.stefandukic.com>
CONTACT_FROM=
# Random secret, at least 32 characters; used to HMAC short-lived limiter keys.
CONTACT_SECRET=
# Shared Redis REST service for atomic rate limits and duplicate suppression.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
